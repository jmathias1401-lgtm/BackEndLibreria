# ==========================================
# CONFIGURACIÓN DE BASE DE DATOS (MYSQL)
# ==========================================
DB_URL=jdbc:mysql://localhost:3306/libreria_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER_NAME=root
DB_PASSWORD=cambiar_por_tu_password_seguro
MYSQL_ROOT_PASSWORD=cambiar_por_tu_password_seguro
MYSQL_DATABASE=libreria_db

# ==========================================
# SEGURIDAD JWT (Generar con: openssl rand -base64 32)
# ==========================================
SECRET_KEY=cambiar_por_tu_clave_secreta_base64_de_minimo_256_bits
EXPIRATION=86400000
REFRESH_EXPIRATION=604800000

# ==========================================
# ALMACENAMIENTO DE ARCHIVOS E IMÁGENES
# ==========================================
APP_RUTA_IMAGENES=D:/PROYECTOS/Libreria/newfarmafrontangular/src/assets/img/imagenes

# ==========================================
# PUERTOS
# ==========================================
PORT=8080

