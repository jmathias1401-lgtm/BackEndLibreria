{
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "chmod +x mvnw && ./mvnw clean package -DskipTests"
  },
  "deploy": {
    "startCommand": "java -XshowSettings:vm -version && java -jar target/*.jar",
    "healthcheckPath": "/api/check",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE"
  }
}